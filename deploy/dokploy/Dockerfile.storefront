# Mercur storefront (Next.js 15) — production image for Dokploy.
# Build context MUST be the repository root:
#   docker build -f deploy/dokploy/Dockerfile.storefront .
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so they
# are build args here, not runtime env. Changing them requires a rebuild, not a
# restart. Dokploy passes them through as build arguments.

FROM node:22-bookworm-slim AS base
COPY --from=oven/bun:1.3.8 /usr/local/bin/bun /usr/local/bin/bun
# `patch` is the fallback backend for deploy/overlays/apply.sh — this image has
# no git. ~200 KB, versus ~40 MB to install git for the same job.
RUN apt-get update && apt-get install -y --no-install-recommends patch \
 && rm -rf /var/lib/apt/lists/*

# Manifest-only stage. Reduces the workspace to just the files `bun install`
# reads, so the install layer below is keyed on those and NOT on source code.
#
# Why: `bun install` takes ~6.4 min on a 3-vCPU host (4334 packages). Copying
# apps/ and packages/ before the install — which is what this used to do — put
# every source file in the install layer's cache key, so ANY code change paid the
# full install again on every deploy. Measured locally: touching one source file
# took this stage from 258 s to 20 s once the install stopped depending on it.
#
# This stage is still invalidated by every source change, but it only copies and
# filters, which costs a second or two.
FROM base AS manifests
WORKDIR /src
COPY package.json bun.lock ./
COPY apps ./apps
COPY packages ./packages
# The root workspaces list is apps/*, packages/*, packages/providers/*,
# integration-tests, e2e-tests AND e2e-tests/hosts/*. Every one must contribute
# its package.json — omitting any workspace makes `bun install
# --frozen-lockfile` reject the lockfile as changed.
COPY integration-tests ./integration-tests
COPY e2e-tests ./e2e-tests
# find rather than an explicit list, so a newly added workspace is picked up
# automatically instead of breaking the install.
RUN mkdir -p /manifests \
 && find . -name node_modules -prune -o -name package.json -print0 \
    | tar -cf - --null -T - \
    | tar -xf - -C /manifests \
 && cp bun.lock /manifests/bun.lock

FROM base AS deps
WORKDIR /repo
# Only manifests + the lockfile. BuildKit keys this COPY on the content of what
# it copies, so a commit touching only source is a cache hit here and below.
COPY --from=manifests /manifests/ ./
# Root config the workspaces resolve at build time. eslint.config.mts in
# particular: apps/storefront ships NO local eslint config, so without the root
# flat config `next build` lints with the default parser and dies on every
# TypeScript file ("Parsing error: The keyword 'export' is reserved").
COPY .npmrc .oxlintrc.json eslint.config.mts ./
# --ignore-scripts: better-sqlite3 is an OPTIONAL PEER of @mikro-orm/knex
# (alongside libsql and mariadb). Mercur runs on Postgres and never loads it, and
# it is not a dependency of the built server — but its install script shells out
# to node-gyp, which needs python3/make/g++ that this slim image does not carry,
# so it fails the whole install. Nothing in this image needs a lifecycle script.
RUN bun install --frozen-lockfile --ignore-scripts

# Sources land AFTER the install, so editing them cannot invalidate it. COPY
# merges into the tree, so the node_modules bun just created survive (the build
# context excludes node_modules anyway — see .dockerignore).
COPY apps ./apps
COPY packages ./packages
COPY integration-tests ./integration-tests
COPY e2e-tests ./e2e-tests
COPY turbo.json ./turbo.json

FROM deps AS build
WORKDIR /repo

# Local overlays: fixes to upstream-tracked files that this repo deliberately
# does NOT commit, so the checkout stays byte-identical to upstream and
# `git merge upstream/main` cannot conflict. They are applied here, on the copy
# inside the image. See deploy/overlays/README.md.
COPY deploy/overlays ./deploy/overlays
RUN bash deploy/overlays/apply.sh
ARG MEDUSA_BACKEND_URL
ARG NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_REGION=de
ARG NEXT_PUBLIC_STRIPE_KEY
ARG NEXT_PUBLIC_SITE_NAME="Mercur Marketplace"
ARG NEXT_PUBLIC_SITE_DESCRIPTION="Mercur Marketplace"
ARG NEXT_PUBLIC_VENDOR_URL
# Optional. Enables the vendor<->customer chat (TalkJS). The storefront reads it
# in three components and falls back to "", so leaving it empty just keeps chat
# off. Without this ARG it could not be set in a production image at all.
ARG NEXT_PUBLIC_TALKJS_APP_ID
ARG REVALIDATE_SECRET
ENV MEDUSA_BACKEND_URL=$MEDUSA_BACKEND_URL \
    NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=$NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY \
    NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL \
    NEXT_PUBLIC_DEFAULT_REGION=$NEXT_PUBLIC_DEFAULT_REGION \
    NEXT_PUBLIC_STRIPE_KEY=$NEXT_PUBLIC_STRIPE_KEY \
    NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME \
    NEXT_PUBLIC_SITE_DESCRIPTION=$NEXT_PUBLIC_SITE_DESCRIPTION \
    NEXT_PUBLIC_VENDOR_URL=$NEXT_PUBLIC_VENDOR_URL \
    NEXT_PUBLIC_TALKJS_APP_ID=$NEXT_PUBLIC_TALKJS_APP_ID \
    REVALIDATE_SECRET=$REVALIDATE_SECRET \
    NEXT_TELEMETRY_DISABLED=1
# The storefront imports @mercurjs/client and @mercurjs/types as workspace packages.
# Build parallelism. On a small host this matters more than memory: turbo.json
# sets concurrency 20, esbuild's Go runtime and SWC's rayon pool each size
# themselves to the core count, so ONE image build can still saturate every vCPU
# and starve Traefik and the Dokploy panel — which is how a deploy takes the
# control plane down even with COMPOSE_PARALLEL_LIMIT=1.
#
# Leave at least one core for the rest of the machine:
#   vCPUs   BUILD_JOBS
#   2       1
#   3-4     2
#   8+      cores - 2
ARG BUILD_JOBS=2
ENV GOMAXPROCS=${BUILD_JOBS}
ENV RAYON_NUM_THREADS=${BUILD_JOBS}

RUN bun run build --concurrency=${BUILD_JOBS} --filter=@mercurjs/types --filter=@mercurjs/client
RUN bun run build --concurrency=${BUILD_JOBS} --filter=@mercurjs/storefront

FROM base AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
# next.config.ts sets output:"standalone", so the server plus its pruned
# node_modules ship in .next/standalone. static/ and public/ are not included
# by the standalone tracer and must be copied alongside it.
COPY --from=build /repo/apps/storefront/.next/standalone ./
COPY --from=build /repo/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=build /repo/apps/storefront/public ./apps/storefront/public
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/storefront/server.js"]

# ============================================================================
# Mercur — Dokploy environment
# Paste into the Dokploy Compose service's "Environment" tab and fill in.
# ============================================================================

# --- Domains -----------------------------------------------------------------
# Must match the domains you attach to each service in Dokploy, including https.
# No trailing slashes.
API_PUBLIC_URL=https://api.example.com
STOREFRONT_PUBLIC_URL=https://shop.example.com
VENDOR_PUBLIC_URL=https://vendor.example.com
ADMIN_PUBLIC_URL=https://admin.example.com

# --- Database and cache (SEPARATE Dokploy services) --------------------------
# Create Postgres and Redis as their own Dokploy services, then copy their
# INTERNAL connection details here.
#
# The host must be the service's internal hostname on the Dokploy network.
# NOT localhost or 127.0.0.1 — inside the API container those mean the API
# container itself, which is the single most common cause of a failed deploy.
# NOT the public host either; internal traffic should not leave the server.
DATABASE_URL=postgres://mercur:CHANGE_ME@<postgres-internal-host>:5432/mercur
REDIS_URL=redis://<redis-internal-host>:6379
# If your Redis service has a password:
#   REDIS_URL=redis://:CHANGE_ME@<redis-internal-host>:6379

# The shared Docker network both the databases and this stack are attached to.
# Confirm with `docker network ls` on the server. Only change if yours differs.
DOKPLOY_NETWORK=dokploy-network

# Seconds the API waits for Postgres and Redis before failing. Compose
# depends_on cannot span Dokploy services, so this is the ordering guarantee.
WAIT_TIMEOUT=120

# Milliseconds Medusa allows for its pre-migration probe query. The default
# (10000) can abort a perfectly reachable database; see the note in
# deploy/dokploy/README.md.
MEDUSA_DB_MIGRATION_CONNECTION_TIMEOUT=30000

# Only used by docker-compose.dokploy-bundled.yml, which runs the databases
# inside the stack instead. Ignored by the default compose file.
POSTGRES_USER=mercur
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mercur

# --- Secrets -----------------------------------------------------------------
# Generate each one separately:  openssl rand -base64 32
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME

# --- CORS --------------------------------------------------------------------
# Comma separated, no spaces. Must list the exact public origins.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://admin.example.com,https://api.example.com
VENDOR_CORS=https://vendor.example.com
AUTH_CORS=https://shop.example.com,https://admin.example.com,https://vendor.example.com,https://api.example.com

# --- First admin user --------------------------------------------------------
# Created on boot if absent. Remove ADMIN_PASSWORD after the first deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Storefront (BUILD-TIME — changing these needs a rebuild, not a restart) --
# Leave empty for the FIRST deploy; the key does not exist until the API has
# been migrated and seeded. See README step 6.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=de
NEXT_PUBLIC_SITE_NAME=Mercur Marketplace
NEXT_PUBLIC_SITE_DESCRIPTION=Multi-vendor marketplace
NEXT_PUBLIC_STRIPE_KEY=

# --- File storage ------------------------------------------------------------
# Leave S3_BUCKET empty to use the local provider (uploads land on the `uploads`
# volume). Setting it switches the API to S3 — strongly recommended in
# production: the local provider cannot be shared across API replicas and its
# URLs break if the public origin changes.
#
# Works with any S3-compatible service (AWS, Cloudflare R2, DigitalOcean Spaces,
# Backblaze B2, MinIO).
S3_BUCKET=
S3_REGION=us-east-1
# Public base URL objects are served from (bucket URL or CDN origin).
S3_FILE_URL=
# Required for everything except real AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave the two keys empty and set this to s3-iam-role to use an instance role.
S3_AUTHENTICATION_METHOD=
# Optional
S3_PREFIX=
S3_CACHE_CONTROL=public, max-age=31536000
# MinIO and other path-style services need true; real AWS S3 does not.
S3_FORCE_PATH_STYLE=
# Set to false for buckets that reject ACL headers — AWS Object Ownership
# "BucketOwnerEnforced" (the default since 2023) and Cloudflare R2.
S3_ACL=

# --- Seeding -----------------------------------------------------------------
# true only on a brand-new database. Creates 5 demo sellers, 50 products and
# ~1144 offers. Set back to false immediately after the first successful boot.
RUN_SEED=false

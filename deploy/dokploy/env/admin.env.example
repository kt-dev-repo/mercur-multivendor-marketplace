# =============================================================================
# mercur-admin — Dokploy Application → Environment
# =============================================================================
# Dockerfile : deploy/dokploy/Dockerfile.dashboard
# Build Stage: admin          <-- THIS is what makes it the admin dashboard
# Port       : 80
#
# Both dashboards share one Dockerfile and differ ONLY by Build Stage. Targeting
# a stage builds just that chain, so this image never compiles the other
# dashboard's package.
#
# Build Stage is REQUIRED. A Dockerfile with no target builds whichever stage is
# last, so an empty field used to silently produce the VENDOR dashboard — on the
# admin domain too. The Dockerfile now ends in a guard stage that fails in ~1s
# with "This Dockerfile has no default stage". If you see that, set the field to
# `admin`.
#
# There are only three values, and ALL of them are build-time. A Vite SPA is
# static files served by nginx; there is no server to read an environment
# variable at runtime. Changing anything here means **Redeploy (rebuild)**.
# =============================================================================

# Public API origin, compiled into the bundle. If this is empty at build time
# the dashboard loads fine and then every single API call fails — a blank page
# with console errors, which looks like a broken build rather than a config
# mistake. Verify after building:
#   grep -rl "https://api.example.com" /usr/share/nginx/html/assets
VITE_MERCUR_BACKEND_URL=https://api.example.com

# --- Build -------------------------------------------------------------------
# Caps parallelism inside the build. See api.env.example for the sizing table.
BUILD_JOBS=2

# Node heap ceiling in MB for the vite build. NEVER set this above the RAM the
# host can actually give: Node will not stop at its own limit, it keeps
# allocating until the KERNEL OOM-killer fires, and the kernel picks its victim
# across the whole host — it may kill Traefik or the Dokploy panel instead.
#   host RAM   BUILD_HEAP_MB
#   4 GB       2048   (tight; prefer building in CI)
#   8 GB       4096
#   16 GB+     6144
BUILD_HEAP_MB=6144

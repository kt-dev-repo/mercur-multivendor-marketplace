# =============================================================================
# mercur-api — Dokploy Application → Environment
# =============================================================================
# Dockerfile : deploy/dokploy/Dockerfile.api
# Build Stage: (leave empty)
# Port       : 9000
#
# Deploy this FIRST. The storefront and both dashboards bake the API URL into
# their bundles, and the publishable key does not exist until this has migrated
# and seeded.
#
# Everything here except BUILD_JOBS is RUNTIME. Change it and restart — no
# rebuild needed. That is the opposite of the other three apps.
#
# Add a persistent volume at /app/static if you use the local file provider.
# Without it every upload is lost on redeploy. Not needed once S3_BUCKET is set.
# =============================================================================

# --- Database and cache (INTERNAL hostnames) ---------------------------------
# The host must be the Dokploy service's internal hostname. NOT localhost —
# inside this container that means the API itself, which is the single most
# common cause of a failed first deploy. NOT the public host either.
#
# PASSWORDS IN THESE URLS ARE DIFFERENT FROM THE SECRETS BELOW. A URL password
# must not contain  /  #  ?  [  ]  %  — `new URL()` throws "Invalid URL" on `/`
# and `#`, and the API then dies at the dependency-wait with a message that
# looks like a networking problem. Verified: a base64 secret used as a password
# fails exactly this way, because base64 emits `/`.
#
# So generate database passwords as hex or plain alphanumeric:
#   openssl rand -hex 24
# If you are stuck with a password you cannot change, percent-encode it:
#   / -> %2F    # -> %23    ? -> %3F    @ -> %40    % -> %25
DATABASE_URL=postgres://mercur:CHANGE_ME@<postgres-internal-host>:5432/mercur
REDIS_URL=redis://<redis-internal-host>:6379
# If your Redis service has a password:
#   REDIS_URL=redis://:CHANGE_ME@<redis-internal-host>:6379

# --- Secrets -----------------------------------------------------------------
# Generate each one separately. Prefer HEX — it is URL-safe and env-safe
# everywhere, so the same value can be pasted anywhere without thought:
#
#   openssl rand -hex 32          ->  64 hex chars, 256-bit
#
# `openssl rand -base64 32` is equally strong and works fine for the values
# below, but it can emit `/`, `+` and a trailing `=`. Those are harmless in an
# environment variable — the parser splits on the FIRST `=` and takes the rest
# verbatim — so an existing base64 secret needs no escaping and no regenerating.
# The one character to avoid in ANY value is `$`, which some parsers interpolate.
#
# NEVER reuse a base64 secret as a database password — see the note above
# DATABASE_URL. A `/` in a password makes the URL unparseable.
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# --- CORS --------------------------------------------------------------------
# Comma separated, no spaces, exact scheme, no trailing slash. Every browser
# origin that calls this API must appear, or the browser blocks the call.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://admin.example.com,https://api.example.com
VENDOR_CORS=https://vendor.example.com
AUTH_CORS=https://shop.example.com,https://admin.example.com,https://vendor.example.com,https://api.example.com

# --- Outbound URLs this API calls or embeds ----------------------------------
# Public URLs, because they end up in emails and in the browser.
MERCUR_VENDOR_URL=https://vendor.example.com
STOREFRONT_REVALIDATE_URL=https://shop.example.com
# Must match REVALIDATE_SECRET in the storefront app, or cache revalidation 401s.
STOREFRONT_REVALIDATE_SECRET=CHANGE_ME

# --- First admin user --------------------------------------------------------
# Created on boot if absent; creating an existing user fails harmlessly.
# Remove ADMIN_PASSWORD after the first successful deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Seeding -----------------------------------------------------------------
# true ONLY on a brand-new database. Creates the sales channel, a publishable
# API key, 5 demo sellers, 50 products and ~1144 offers. Set back to false
# immediately after the first successful boot or you will duplicate the data.
RUN_SEED=false

# Port the server listens on. The entrypoint defaults to 9000 if unset; set it
# explicitly so it matches the port you give the Dokploy Application.
PORT=9000

# --- Startup ordering --------------------------------------------------------
# Seconds the entrypoint waits for Postgres and Redis. depends_on does not work
# across Dokploy Applications, so this is the only ordering guarantee.
WAIT_TIMEOUT=120

# Milliseconds Medusa allows for its pre-migration probe (default 10000).
# The default can abort a perfectly reachable database. If you hit it, read
# "A note on the migration connection probe" in deploy/dokploy/README.md before
# believing the error message — it blames the URL, which is usually wrong.
MEDUSA_DB_MIGRATION_CONNECTION_TIMEOUT=30000

# --- File storage ------------------------------------------------------------
# Local provider (default): uploads land on the /app/static volume and every
# file URL is built from this origin, so it must be the PUBLIC API origin.
FILE_BACKEND_URL=https://api.example.com/static

# Setting S3_BUCKET switches the API to S3 and makes FILE_BACKEND_URL moot.
# Strongly recommended in production: the local provider cannot be shared across
# replicas and its URLs break if the public origin changes.
# Works with AWS, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO.
S3_BUCKET=
S3_REGION=us-east-1
# Public base URL objects are served from (bucket URL or CDN origin).
S3_FILE_URL=
# Required for everything except real AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave both keys empty and set this to s3-iam-role to use an instance role.
S3_AUTHENTICATION_METHOD=
# Optional
S3_PREFIX=
S3_CACHE_CONTROL=public, max-age=31536000
# MinIO and other path-style services need true; real AWS S3 does not.
S3_FORCE_PATH_STYLE=
# Set false for buckets that reject ACL headers — AWS Object Ownership
# "BucketOwnerEnforced" (the default since 2023) and Cloudflare R2.
S3_ACL=
# Optional escape hatch: JSON merged into the S3 client config. It is JSON.parse'd
# at config load, so malformed JSON stops the API from booting with a parse error
# rather than an S3 error. Leave empty unless you actually need it.
S3_ADDITIONAL_CLIENT_CONFIG=

# --- Build (the ONLY build-time value here) ----------------------------------
# Caps parallelism inside the build. turbo.json sets concurrency 20 and
# esbuild/SWC size their pools to the core count, so one build can peg every
# vCPU and starve Traefik and the Dokploy panel.
#   vCPUs  BUILD_JOBS
#   2      1
#   3-4    2
#   8+     cores - 2
BUILD_JOBS=2

# NOTE: Dockerfile.api has NO BUILD_HEAP_MB. Setting it on this app does
# nothing. It exists only for the two dashboards.

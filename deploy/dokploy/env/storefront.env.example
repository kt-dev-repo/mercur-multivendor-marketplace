# =============================================================================
# mercur-storefront — Dokploy Application → Environment
# =============================================================================
# Dockerfile : deploy/dokploy/Dockerfile.storefront
# Build Stage: (leave empty)
# Port       : 3000
#
# Deploy SECOND, after the API has migrated and seeded — you need the
# publishable key below, and it does not exist before that.
#
# ****  EVERY NEXT_PUBLIC_* VALUE IS BAKED IN AT BUILD TIME.  ****
# They are compiled into the JavaScript the browser downloads. Changing one here
# and hitting Restart does NOTHING. You must **Redeploy (rebuild)**. This is the
# single most common "I changed it and nothing happened" on this stack.
#
# Only MEDUSA_BACKEND_URL and REVALIDATE_SECRET are read at runtime as well.
# =============================================================================

# --- API ---------------------------------------------------------------------
# Server-side calls from the Next.js server to the API. Public origin, because
# the browser follows the same URLs.
MEDUSA_BACKEND_URL=https://api.example.com

# Publishable key scoping the storefront to a sales channel. Read it AFTER the
# API has seeded:
#   Admin → Settings → Publishable API Keys, or
#   select token from api_key where type='publishable' and revoked_at is null;
# Without it the shop renders with zero products and no obvious error.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME

# --- Site --------------------------------------------------------------------
# This storefront's own public origin (canonical URLs, redirects, metadata).
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# Must match a region the seed created, or the storefront renders empty. The
# seed creates ONE region covering gb de dk se fr es it; the default is de.
NEXT_PUBLIC_DEFAULT_REGION=de

NEXT_PUBLIC_SITE_NAME=Mercur Marketplace
NEXT_PUBLIC_SITE_DESCRIPTION=Multi-vendor marketplace

# Where "visit seller dashboard" style links point.
NEXT_PUBLIC_VENDOR_URL=https://vendor.example.com

# --- Optional integrations ---------------------------------------------------
# Stripe publishable key. Leave empty to build without card payments.
NEXT_PUBLIC_STRIPE_KEY=

# TalkJS app id — enables vendor<->customer chat. Leave empty to keep chat off;
# the storefront falls back to "" and the feature stays inert.
NEXT_PUBLIC_TALKJS_APP_ID=

# --- Cache revalidation ------------------------------------------------------
# Must match STOREFRONT_REVALIDATE_SECRET in the api app. Generate with
# `openssl rand -hex 32` — hex is URL-safe and env-safe everywhere. base64 works
# too; its `/`, `+` and trailing `=` are harmless in an environment variable. The API calls this
# storefront to bust its cache; a mismatch shows up as silent 401s and a
# storefront that serves stale pages forever.
REVALIDATE_SECRET=CHANGE_ME

# --- Build -------------------------------------------------------------------
# See api.env.example for the sizing table.
BUILD_JOBS=2

# NOTE: Dockerfile.storefront has NO BUILD_HEAP_MB. Setting it here does
# nothing — it applies only to the two dashboards.

# Admin and Vendor dashboards (Vite SPAs) — production images for Dokploy.
#
# ONE Dockerfile, TWO final stages, so each dashboard deploys as its own Dokploy
# Application and you choose when each one builds. In the Dokploy Application set
# **Docker Build Stage** to `admin` or `vendor`; on the CLI use `--target`:
#
#   docker build -f deploy/dokploy/Dockerfile.dashboard --target admin  .
#   docker build -f deploy/dokploy/Dockerfile.dashboard --target vendor .
#
# Targeting a stage builds only that chain, so the admin image never compiles the
# vendor package and vice versa. The shared work (install + common packages) sits
# in `build-common` and is reused by both through the layer cache.
#
# Build context MUST be the repository root.
#
# Neither app declares a "build" script upstream, so vite is invoked directly.
# VITE_MERCUR_BACKEND_URL is baked in at BUILD time — changing it needs a rebuild,
# not a restart.

FROM node:22-bookworm-slim AS base
COPY --from=oven/bun:1.3.8 /usr/local/bin/bun /usr/local/bin/bun
# `patch` is the fallback backend for deploy/overlays/apply.sh — this image has
# no git. ~200 KB, versus ~40 MB to install git for the same job.
RUN apt-get update && apt-get install -y --no-install-recommends patch \
 && rm -rf /var/lib/apt/lists/*

FROM base AS deps
WORKDIR /repo
COPY package.json bun.lock ./
# Root config the workspaces resolve at build time. eslint.config.mts in
# particular: apps/storefront ships NO local eslint config, so without the root
# flat config `next build` lints with the default parser and dies on every
# TypeScript file ("Parsing error: The keyword 'export' is reserved").
COPY .npmrc .oxlintrc.json eslint.config.mts ./
COPY apps ./apps
COPY packages ./packages
# The root workspaces list includes integration-tests, e2e-tests AND
# e2e-tests/hosts/*. Copy those trees whole — omitting any workspace makes
# `bun install --frozen-lockfile` reject the lockfile as changed.
COPY integration-tests ./integration-tests
COPY e2e-tests ./e2e-tests
COPY turbo.json ./turbo.json
# --ignore-scripts: better-sqlite3 is an OPTIONAL PEER of @mikro-orm/knex
# (alongside libsql and mariadb). Mercur runs on Postgres and never loads it, and
# it is not a dependency of the built server — but its install script shells out
# to node-gyp, which needs python3/make/g++ that this slim image does not carry,
# so it fails the whole install. Nothing in this image needs a lifecycle script.
RUN bun install --frozen-lockfile --ignore-scripts

FROM deps AS build-common
ARG VITE_MERCUR_BACKEND_URL
ENV VITE_MERCUR_BACKEND_URL=$VITE_MERCUR_BACKEND_URL
# Build parallelism. On a small host this matters more than memory: turbo.json
# sets concurrency 20, esbuild's Go runtime and SWC's rayon pool each size
# themselves to the core count, so ONE image build can still saturate every vCPU
# and starve Traefik and the Dokploy panel.
#
# Leave at least one core for the rest of the machine:
#   vCPUs   BUILD_JOBS
#   2       1
#   3-4     2
#   8+      cores - 2
ARG BUILD_JOBS=2
ENV GOMAXPROCS=${BUILD_JOBS}
ENV RAYON_NUM_THREADS=${BUILD_JOBS}
# NEVER set the heap above the RAM the host can give. A ceiling larger than
# available memory is worse than none: Node will not fail at its own limit, it
# keeps allocating until the KERNEL OOM-killer fires — and the kernel picks its
# victim across the whole host, so it may kill Traefik or the panel instead.
#   4 GB -> 2048 · 8 GB -> 4096 · 16 GB+ -> 6144
ARG BUILD_HEAP_MB=6144
ENV NODE_OPTIONS=--max-old-space-size=${BUILD_HEAP_MB}
WORKDIR /repo

# Local overlays: fixes to upstream-tracked files that this repo deliberately
# does NOT commit, so the checkout stays byte-identical to upstream and
# `git merge upstream/main` cannot conflict. Applied here, on the copy inside
# the image. See deploy/overlays/README.md.
COPY deploy/overlays ./deploy/overlays
RUN bash deploy/overlays/apply.sh

# Dependencies shared by both dashboards. Cached once, reused by both targets.
RUN bun run build --concurrency=${BUILD_JOBS} \
                  --filter=@mercurjs/types --filter=@mercurjs/client \
                  --filter=@mercurjs/dashboard-sdk --filter=@mercurjs/dashboard-shared

# `--no-dts` (cac boolean negation, honoured by tsup) skips .d.ts generation.
# It dominates this build and is worthless in a runtime image: neither app runs
# tsc, `vite build` only bundles JS, and nothing inside the container imports
# types. Takes the vendor package from ~19s to ~1s.
FROM build-common AS build-admin
RUN cd packages/admin && bun x tsup --no-dts && bun run generate:targets
WORKDIR /repo/apps/admin-test
RUN node ./node_modules/.bin/vite build && test -d dist

FROM build-common AS build-vendor
RUN cd packages/vendor && bun x tsup --no-dts && bun run generate:targets
WORKDIR /repo/apps/vendor
RUN node ./node_modules/.bin/vite build && test -d dist

# --- runtime stages: pick one with --target / Docker Build Stage ---

FROM nginx:1.27-alpine AS admin
COPY --from=build-admin /repo/apps/admin-test/dist /usr/share/nginx/html
COPY deploy/dokploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

FROM nginx:1.27-alpine AS vendor
COPY --from=build-vendor /repo/apps/vendor/dist /usr/share/nginx/html
COPY deploy/dokploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1

# Guard. MUST stay the last stage in this file.
#
# Without it, a build with no target silently produces whichever runtime stage
# happens to be last — so an `admin` Application with the Build Stage field left
# empty would deploy the VENDOR dashboard to the admin domain and look fine.
# Verified: building this Dockerfile with no --target exited 0 and produced a
# byte-identical copy of the vendor image.
#
# Being last and depending on nothing, this fails in about a second, before any
# of the expensive build stages run.
FROM alpine:3.20 AS _select_a_stage
RUN echo >&2 "" \
 && echo >&2 "This Dockerfile has no default stage. Pick one:" \
 && echo >&2 "  Dokploy  -> set the Application's 'Docker Build Stage' to admin or vendor" \
 && echo >&2 "  CLI      -> docker build --target admin  -f deploy/dokploy/Dockerfile.dashboard ." \
 && echo >&2 "              docker build --target vendor -f deploy/dokploy/Dockerfile.dashboard ." \
 && echo >&2 "" \
 && exit 1

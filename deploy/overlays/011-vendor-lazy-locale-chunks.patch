 export const defaultI18nOptions: InitOptions = {
   debug: process.env.NODE_ENV === "development",
   detection: {
@@ -12,5 +14,10 @@ export const defaultI18nOptions: InitOptions = {
   fallbackNS: "translation",
   interpolation: {
     escapeValue: false,
-  }
+  },
+  // Only `en` is bundled; the rest arrive through the lazy backend. Without
+  // this, i18next treats a language it has partial resources for as fully
+  // loaded and never calls the backend.
+  partialBundledLanguages: true,
+  supportedLngs: supportedLanguages,
 }

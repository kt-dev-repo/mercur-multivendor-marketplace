# 011 — the vendor panel no longer ships all 31 locales to every user.
#
# The same defect as overlay 010, in packages/vendor. src/i18n/translations/
# index.ts statically imported 31 locale JSON files into one object handed to
# i18next as `resources`; nothing reachable from that literal can be split, so
# the catalogue landed in a single 9.1 MB chunk (~6.2 MB of it JSON) that every
# user downloaded to read one language.
#
# English stays eager — it is `fallbackLng`, so i18next must resolve it
# synchronously before first render. The other 30 become dynamic import()s
# behind a zero-dependency i18next backend module, so the bundler emits one
# chunk per locale and fetches only the active one. Largest chunk drops from
# 9.1 MB to 544 KB.
#
# One difference from 010: vendor's i18n/config.ts sets neither `resources` nor
# `supportedLngs` (the initializer supplies resources), so this patch adds
# `supportedLngs` alongside `partialBundledLanguages` and keeps the existing
# `fallbackNS`.
#
# `partialBundledLanguages: true` is required: without it i18next sees partial
# resources for a language and never calls the backend.
#
# Override precedence is preserved — the consumer's `virtual:mercur/i18n` entry
# is merged over each locale as it lands, which is what the eager deepMerge did.

diff --git a/packages/vendor/src/components/utilities/i18n/i18n.tsx b/packages/vendor/src/components/utilities/i18n/i18n.tsx
index 2151fc5a1..dbb18d9f0 100644
--- a/packages/vendor/src/components/utilities/i18n/i18n.tsx
+++ b/packages/vendor/src/components/utilities/i18n/i18n.tsx
@@ -1,9 +1,10 @@
 import i18n from "i18next";
+import type { BackendModule, ReadCallback } from "i18next";
 import LanguageDetector from "i18next-browser-languagedetector";
 import { initReactI18next } from "react-i18next";
 
 import { defaultI18nOptions } from "../../../i18n/config";
-import translations from "../../../i18n/translations";
+import translations, { translationLoaders } from "../../../i18n/translations";
 import customI18nResources from "virtual:mercur/i18n";
 import config from "virtual:mercur/config";
 
@@ -31,6 +32,48 @@ function deepMerge(
   return result;
 }
 
+const customResources = customI18nResources as Record<
+  string,
+  { translation?: Record<string, any> } | undefined
+>;
+
+const customTranslationFor = (language: string): Record<string, any> =>
+  customResources?.[language]?.translation ?? {};
+
+// Only `en` ships in the bundle. Every other locale is fetched on first use, so
+// a user reading one language no longer downloads all of them — that was ~6.2 MB
+// of JSON in a single chunk. Overriding still works: the consumer's
+// virtual:mercur/i18n entry for a language is merged over the locale once it
+// lands, which is the same precedence the eager path had.
+const lazyTranslationBackend: BackendModule = {
+  type: "backend",
+  init: () => {},
+  read: (language: string, _namespace: string, callback: ReadCallback) => {
+    const load = translationLoaders[language];
+
+    if (!load) {
+      // Unknown language, or `en`, which is already bundled. Returning an empty
+      // resource lets i18next fall back rather than hang waiting on a read.
+      callback(null, customTranslationFor(language));
+      return;
+    }
+
+    load()
+      .then((module) => {
+        callback(
+          null,
+          deepMerge(
+            module.default as Record<string, any>,
+            customTranslationFor(language),
+          ),
+        );
+      })
+      .catch((error) => {
+        callback(error as Error, null);
+      });
+  },
+};
+
 const mergedTranslations = deepMerge(translations, customI18nResources);
 
 export const I18n = () => {
@@ -45,6 +88,7 @@ export const I18n = () => {
         lookupLocalStorage: "lng",
       }),
     )
+    .use(lazyTranslationBackend)
     .use(initReactI18next)
     .init({
       ...defaultI18nOptions,
